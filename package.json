{
  "name": "cafe-cortero",
  "private": true,
  "scripts": {
    "dev": "npx live-server --port=3005 --no-browser --wait=200 --ignore=\"server.log,.git,node_modules\"",
    "dev:open": "npx live-server --port=3005 --wait=200 --ignore=\"server.log,.git,node_modules\"",
    "dev:safe": "powershell -ExecutionPolicy Bypass -File scripts/start-server.ps1 -Port 3005",
    "dev:safe:open": "powershell -ExecutionPolicy Bypass -File scripts/start-server.ps1 -Port 3005 -OpenBrowser"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.107.0"
  }
}
