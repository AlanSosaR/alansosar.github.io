.hidden { display: none !important; }
.fade-in { animation: fadeIn 0.4s ease-out; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

/* COLORES ESTADOS */
.status-pending { background: #FF9800; }
.status-preparing { background: #2196F3; }
.status-shipped { background: #9C27B0; }
.status-delivered { background: #4CAF50; }
.status-cancelled { background: #f44336; }

@media (max-width: 768px) {
    .page-title-section-stitch {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        padding: 0 16px;
    }

    .orders-layout-stitch {
        grid-template-columns: 1fr !important;
        padding: 0 16px 160px 16px;
        gap: 0;
    }

    /* Maestro-Detalle Mobile Pattern */
    body.detail-view-active .orders-list-section-stitch {
        display: none !important;
    }

    body:not(.detail-view-active) .order-detail-section-stitch {
        display: none !important;
    }

    .detail-grid-stitch {
        grid-template-columns: 1fr !important;
        gap: 16px;
    }

    .detail-header-stitch-alt {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
    }

    .header-actions-stitch {
        width: 100%;
        justify-content: flex-start;
        flex-wrap: wrap;
    }

    .header-actions-stitch button {
        flex: 1;
        min-width: 140px;
    }

    .status-actions-grid {
        grid-template-columns: repeat(2, 1fr) !important;
    }

    .btn-mobile-back {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #F1F3F2;
        border: none;
        color: var(--primary-green);
        font-weight: 700;
        margin-bottom: 20px;
        cursor: pointer;
        padding: 10px 16px;
        border-radius: 12px;
        width: fit-content;
    }

    .confirm-snack {
        width: 90%;
        flex-direction: column;
        gap: 12px;
        padding: 16px;
        text-align: center;
    }
}

@media (min-width: 769px) {
    .btn-mobile-back {
        display: none;
    }
}
